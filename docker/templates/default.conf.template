# nginx config for the CS2 Replica game site.
#
# Rendered by the nginx image entrypoint (envsubst) from
# docker/templates/default.conf.template. ${BASE_PATH} is replaced at runtime
# with the value used to build the site (default "/").

server {
    listen       80;
    listen  [::]:80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # ---- gzip ------------------------------------------------------------ #
    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_proxied    any;
    gzip_types      text/plain text/css text/javascript
                    application/javascript application/json
                    application/manifest+json application/wasm
                    image/svg+xml application/octet-stream;

    # ---- hashed build assets: cache forever ------------------------------ #
    location ${BASE_PATH}assets/ {
        access_log off;
        expires    1y;
        add_header Cache-Control   "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy  "strict-origin-when-cross-origin" always;
        try_files  $uri =404;
    }

    # ---- SPA fallback ---------------------------------------------------- #
    location ${BASE_PATH} {
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy  "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ ${BASE_PATH}index.html;
    }

    # index.html must never be cached: it points at the hashed assets.
    location = ${BASE_PATH}index.html {
        add_header Cache-Control        "no-cache, no-store, must-revalidate" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy      "strict-origin-when-cross-origin" always;
    }
}
